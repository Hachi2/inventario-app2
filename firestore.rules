// =========================================================
// firestore.rules
// Reglas de seguridad de Firestore — controlan quién puede leer
// y escribir cada colección, replicando los mismos roles que ya
// tiene la app (Coordinador/Analista/Auxiliar).
//
// CÓMO INSTALARLAS: en la consola de Firebase → Firestore Database
// → pestaña "Reglas" → pega este archivo completo → "Publicar".
//
// NOTA DE SEGURIDAD — por qué "que no se vea el código" no es la
// forma de proteger esto: cualquier página web (esta incluida) se
// puede inspeccionar desde el navegador — es así como funciona la
// web, ninguna app hecha en HTML/JS puede evitarlo, ni ofuscando ni
// minificando el código (eso solo lo hace más feo de leer, no
// imposible). Por eso la seguridad real nunca depende de esconder el
// código: depende de qué puede hacer alguien con los datos aunque
// tenga el código completo delante — y eso es exactamente lo que
// controla este archivo, del lado del servidor de Firebase, no del
// navegador de nadie. Dos capas más, cuando quieras subir el nivel:
//  1) Firebase App Check (gratis): verifica que cada pedido a
//     Firestore venga de verdad de esta app y no de alguien que copió
//     la clave y escribe directo con un script — se activa desde la
//     consola de Firebase, sin tocar este archivo.
//  2) Fase 5 del plan (login real con Firebase Authentication):
//     recién ahí estas reglas pueden exigir el rol correcto de cada
//     quien, en vez de solo "estar autenticado" en general.
// =========================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // NOTA IMPORTANTE (por qué no se filtra por rol todavía):
    // Mientras el login real de la app (Fase 5) no esté conectado a
    // Firebase Authentication, cada dispositivo entra a la nube con una
    // sesión "anónima" (ver firebase-sync.js) — no hay forma de saber,
    // desde estas reglas, si esa sesión anónima es un Auxiliar o un
    // Coordinador. Por eso, por ahora, cualquier sesión autenticada
    // (incluida la anónima) puede leer y escribir — el control de qué
    // puede tocar cada rol se sigue haciendo del lado de la app, igual
    // que hoy. La primera versión de este archivo intentaba filtrar por
    // rol (función esGestor) y por eso nada se estaba sincronizando: esa
    // función buscaba un documento de usuario que no existe para una
    // sesión anónima, así que TODA escritura de "almacenes" (crear un
    // almacén nuevo, es decir, cargar un Excel) se rechazaba en
    // silencio. Cuando la Fase 5 conecte el login real, esto se
    // endurece para exigir el rol correcto de verdad.
    function estaAutenticado() {
      return request.auth != null;
    }

    match /usuarios/{uid} {
      allow read, write: if estaAutenticado();
    }

    match /almacenes/{almacenId} {
      allow read, write: if estaAutenticado();
    }

    match /inventario/{itemId} {
      allow read: if estaAutenticado();
      // Validación mínima: toda fila de inventario debe traer a qué
      // almacén pertenece. No evita que alguien con malas intenciones
      // escriba datos falsos (eso lo resuelve la Fase 5 + App Check,
      // ver la nota de seguridad al principio de este archivo) — pero
      // sí evita que un error de programación deje filas "huérfanas"
      // sin almacén, que romperían las búsquedas.
      allow write: if estaAutenticado() &&
                      request.resource.data._almacenId is string &&
                      request.resource.data._almacenId.size() > 0;
    }

    // ---- auditoria: de solo agregar — nadie edita ni borra un
    // registro de actividad ya escrito ----
    match /auditoria/{registroId} {
      allow read: if estaAutenticado();
      allow create: if estaAutenticado();
      allow update, delete: if false;
    }

    // ---- _diagnostico: SOLO para el botón "Probar conexión" de
    // Ajustes. No guarda ningún dato real ni sensible. ----
    match /_diagnostico/{docId} {
      allow read, write: if true;
    }
  }
}
